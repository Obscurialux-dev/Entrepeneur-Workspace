# =============================================================================
# Entrepreneur Workspace — environment placeholders
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real credentials, service-account JSON, or OAuth tokens.
# This file must contain placeholders only; real values belong in `.env.local`.
# `.env.example` is tracked by Git; `.env.local` is ignored.
# =============================================================================

# --- Firebase Web SDK (public identifiers, safe to expose to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only, never NEXT_PUBLIC_) ---
# Locally, prefer the Firebase Emulator Suite (no service account needed).
# For deployed environments, provide the service-account JSON as a single value in
# FIREBASE_SERVICE_ACCOUNT_KEY, or the three individual fields below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase Emulator Suite (local development only) ---
# Set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true to connect the browser SDK to the
# emulators. `npm run test:emulator` sets the *_EMULATOR_HOST values itself.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# --- Google integrations (deferred; server-side only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# INTERIM PROTOTYPE ONLY — used by the prototype session fallback when no valid
# Firebase session cookie exists (see docs/task.md T012/T013).
# Development-only: must never be configured in the production environment.
# Allowed: entrepreneur_admin | research | marketing | executive_viewer
# Do NOT rely on this for production security; real roles come from Firebase Auth
# custom claims. Remove this variable once the prototype fallback is deleted.
WORKSPACE_PROTOTYPE_ROLE=
