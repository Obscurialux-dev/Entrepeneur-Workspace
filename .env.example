# =============================================================================
# Entrepreneur Workspace — environment placeholders
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real credentials, service-account JSON, or OAuth tokens.
# Firebase is intentionally NOT configured yet (see docs/task.md).
# =============================================================================

# --- Firebase Web SDK (public identifiers, safe to expose to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin / Cloud Functions (server-only, never NEXT_PUBLIC_) ---
# Prefer Application Default Credentials locally with the Firebase Emulator Suite.
# For deployed environments, provide the service-account JSON as a single env value.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase Emulator Suite (local development only) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# --- Google integrations (deferred; server-side only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
